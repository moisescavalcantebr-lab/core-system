
# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

RewriteEngine On

# redireciona URLs antigas /public → /web
RewriteCond %{REQUEST_URI} ^/public/
RewriteRule ^public/(.*)$ /web/$1 [L,R=301]
# Core: private source, configuration, backups and logs must not be served.
Options -Indexes
RewriteEngine On
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule (^|/)_notes(?:/|$) - [F,L,NC]
RewriteRule ^(?:projects/[^/]+/)?storage/uploads/avatars/[a-zA-Z0-9_-]+\.(?:png|jpe?g|gif|webp)$ - [L,NC]
RewriteRule ^projects/[a-zA-Z0-9_-]+/web/storage/uploads/avatars/[a-zA-Z0-9_-]+\.(?:png|jpe?g|gif|webp)$ - [L,NC]
RewriteRule (^|/)(?:env|storage|docker|cron|docs|scripts|tmp|output|_backups|_deploy)(?:/|$) - [F,L,NC]
RewriteRule (^|/)app/(?!actions(?:/|$)) - [F,L,NC]
RewriteRule ^(?:bases|modules|vendor)(?:/|$) - [F,L,NC]
<FilesMatch "(?i)(?:\.(?:sql|log|bak|dump|ini|env|ps1|sh|ya?ml)|composer\.(?:json|lock))$">
    Require all denied
</FilesMatch>
