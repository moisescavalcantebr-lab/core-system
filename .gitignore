# =========================
# ENV (nunca versionar)
# =========================
/env/*.php
!/env/*.example.php

# =========================
# STORAGE (arquivos gerados)
/storage/*
!/storage/.gitkeep

# =========================
# PROJECTS (instâncias dinâmicas)
/projects/*
!/projects/.gitkeep

# =========================
# LOGS / CACHE
*.log
*.cache

# =========================
# SQL (controle fino)
backup.sql
*.dump.sql
!bases/**/database/*.sql

# =========================
# DOCKER
docker/mysql/data/
docker/mysql/logs/
docker/**/*.log
docker/**/*.pid

# =========================
# VS CODE
.vscode/

# =========================
# SISTEMA
node_modules/
vendor/

# =========================
# TEMP
*.tmp
*.bak
*.swp

# =========================
# OS
.DS_Store
Thumbs.db