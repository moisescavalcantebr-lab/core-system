# =========================
# ENV (nunca versionar)
# =========================
/env/*.php
!/env/*.example.php

# =========================
# STORAGE (arquivos gerados)
/storage/*
!/storage/.gitkeep
/web/assets/uploads/*
!/web/assets/uploads/.gitkeep

# =========================
# PROJECTS (instâncias dinâmicas)
/projects/*
!/projects/.gitkeep

# =========================
# LOGS / CACHE
*.log
*.cache

# =========================
# SQL (controle fino)
backup.sql
*.dump.sql
!bases/**/database/*.sql

# =========================
# DOCKER
docker/mysql/data/
docker/mysql/logs/
docker/**/*.log
docker/**/*.pid

# =========================
# VS CODE
.vscode/

# DEPLOY LOCAL
/scripts/deploy.local.ps1
/_deploy/
/_backups/

# =========================
# SISTEMA
node_modules/
vendor/

# =========================
# TEMP
/tmp/
/output/
*.tmp
*.bak
*.swp

# =========================
# OS
.DS_Store
Thumbs.db
